# Local prototype env — copy to .env and fill in. Never commit .env.
PORT=3000

# PostgreSQL running on this device (portable install, no Docker needed)
DATABASE_URL=postgresql://campusfix:campusfix@localhost:5433/campusfix

# Better Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary (free plan) — from https://cloudinary.com/console (no card required)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — from https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=CampusFix <onboarding@resend.dev>
